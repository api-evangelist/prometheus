            "name": "Prometheus Reload configuration",
            "description": {
              "content": "Triggers a reload of the Prometheus configuration file and rule files. Returns 200 when the reload is successful and 500 if the reload fails. Requires --web.enable-lifecycle flag. Also triggered by sending SIGHUP to the Prometheus process.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "-",
                "reload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Alertmanager server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Alertmanager server port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
