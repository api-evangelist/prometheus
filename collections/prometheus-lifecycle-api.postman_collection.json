      "id": "5505c657-83d7-4f63-ac60-bf3688048cdc",
      "name": "Lifecycle",
      "description": {
        "content": "Endpoints for managing the Prometheus server lifecycle including configuration reloads and graceful shutdown. Requires --web.enable-lifecycle flag.",
        "type": "text/plain"
      },
      "item": [
        {
