                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"headStats\": {\n      \"numSeries\": 5013,\n      \"numLabelPairs\": 2998,\n      \"chunkCount\": 1928,\n      \"minTime\": 7228,\n      \"maxTime\": 2333\n    },\n    \"seriesCountByMetricName\": [\n      {\n        \"name\": \"string\",\n        \"value\": 6778\n      },\n      {\n        \"name\": \"string\",\n        \"value\": 6966\n      }\n    ],\n    \"labelValueCountByLabelName\": [\n      {\n        \"name\": \"string\",\n        \"value\": 5694\n      },\n      {\n        \"name\": \"string\",\n        \"value\": 6590\n      }\n    ],\n    \"memoryInBytesByLabelName\": [\n      {\n        \"name\": \"string\",\n        \"value\": 7799\n      },\n      {\n        \"name\": \"string\",\n        \"value\": 1944\n      }\n    ]\n  }\n}",
              "cookie": [],
