        {
          "id": "d6a844c8-e8e4-4e5e-a0d5-370e1dc8b38a",
          "name": "Prometheus Get TSDB statistics",
          "request": {
            "name": "Prometheus Get TSDB statistics",
            "description": {
              "content": "Returns a set of properties about the Prometheus TSDB including the top series by label count, top chunks by label, most frequently changing metrics, and head statistics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "status",
                "tsdb"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of items to return."
                }
              ],
              "variable": [
                {
                  "description": "Alertmanager server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Alertmanager server port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a8722ac0-b597-4d22-a5f6-7f02f2b44248",
              "name": "TSDB statistics returned successfully",
              "originalRequest": {
                "url": {
                  "path": [
