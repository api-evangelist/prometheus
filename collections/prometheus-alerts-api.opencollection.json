{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prometheus Alertmanager Admin Alerts API",
    "version": "v0.28.0"
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prometheus Get active alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/api/v2/alerts",
            "params": [
              {
                "name": "active",
                "value": "",
                "type": "query",
                "description": "Only return active (non-silenced, non-inhibited) alerts."
              },
              {
                "name": "silenced",
                "value": "",
                "type": "query",
                "description": "Include silenced alerts in results."
              },
              {
                "name": "inhibited",
                "value": "",
                "type": "query",
                "description": "Include inhibited alerts in results."
              },
              {
                "name": "unprocessed",
                "value": "",
                "type": "query",
                "description": "Include unprocessed alerts that have not yet been routed."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "A list of label matchers to filter alerts by. Matchers use the syntax label=value, label!=value, label=~regex, or label!~regex."
              },
              {
                "name": "receiver",
                "value": "",
                "type": "query",
                "description": "Filter by receiver name."
              }
            ]
          },
          "docs": "Returns a list of active alerts currently managed by Alertmanager. Supports filtering by silenced, inhibited, active state, and label matchers."
        },
        {
          "info": {
            "name": "Prometheus Post alerts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{host}:{port}/api/v2/alerts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates alerts in Alertmanager. Prometheus typically calls this endpoint to send firing alerts. Each alert must include a labels map; generatorURL is optional but recommended for linking back to the triggering expression."
        },
        {
          "info": {
            "name": "Prometheus Get alert groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/api/v2/alerts/groups",
            "params": [
              {
                "name": "active",
                "value": "",
                "type": "query",
                "description": "Include active alerts."
              },
              {
                "name": "silenced",
                "value": "",
                "type": "query",
                "description": "Include silenced alerts."
              },
              {
                "name": "inhibited",
                "value": "",
                "type": "query",
                "description": "Include inhibited alerts."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Label matchers to filter by."
              },
              {
                "name": "receiver",
                "value": "",
                "type": "query",
                "description": "Filter by receiver name."
              }
            ]
          },
          "docs": "Returns a list of alert groups. Alertmanager groups alerts by their group labels as configured in routing rules. Each group has a receiver and a set of alerts."
        },
        {
          "info": {
            "name": "Prometheus Get alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/api/v1/alerts"
          },
          "docs": "Returns a list of all active alerts currently firing or pending in Prometheus. Alerts include their labels, state, and timestamps."
        }
      ]
    }
  ],
  "bundled": true
}