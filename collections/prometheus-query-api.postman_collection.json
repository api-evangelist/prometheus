              "path": [
                "api",
                "v1",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) PromQL expression to evaluate."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "Evaluation timestamp as a Unix timestamp or RFC3339 string. Defaults to current server time."
                },
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "<string>",
                  "description": "Evaluation timeout as a duration string (e.g., 30s)."
                }
