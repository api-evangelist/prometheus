        {
          "id": "d96e1e3d-38fd-43fa-ab2a-a9eb9440ae95",
          "name": "Prometheus Delete series",
          "request": {
            "name": "Prometheus Delete series",
            "description": {
              "content": "Deletes data for a selection of series in a time range by creating tombstones. The series data is not immediately removed but marked for deletion during the next compaction cycle. Requires --web.enable-admin-api flag.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "admin",
                "tsdb",
                "delete_series"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "match[]",
                  "value": "<string>",
                  "description": "(Required) Repeated label matcher argument to select series to delete."
                },
                {
                  "disabled": false,
                  "key": "match[]",
                  "value": "<string>",
                  "description": "(Required) Repeated label matcher argument to select series to delete."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Start of the time range to delete. Defaults to minimum time."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End of the time range to delete. Defaults to maximum time."
                }
              ],
              "variable": [
                {
                  "description": "Alertmanager server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Alertmanager server port",
                  "type": "any",
