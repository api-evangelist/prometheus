          "name": "Prometheus Get active alerts",
          "request": {
            "name": "Prometheus Get active alerts",
            "description": {
              "content": "Returns a list of active alerts currently managed by Alertmanager. Supports filtering by silenced, inhibited, active state, and label matchers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "active",
                  "value": "true",
                  "description": "Only return active (non-silenced, non-inhibited) alerts."
                },
                {
                  "disabled": false,
                  "key": "silenced",
                  "value": "false",
                  "description": "Include silenced alerts in results."
                },
                {
                  "disabled": false,
                  "key": "inhibited",
                  "value": "false",
                  "description": "Include inhibited alerts in results."
                },
                {
                  "disabled": false,
                  "key": "unprocessed",
                  "value": "false",
                  "description": "Include unprocessed alerts that have not yet been routed."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "A list of label matchers to filter alerts by. Matchers use the syntax label=value, label!=value, label=~regex, or label!~regex."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "A list of label matchers to filter alerts by. Matchers use the syntax label=value, label!=value, label=~regex, or label!~regex."
                },
                {
                  "disabled": false,
                  "key": "receiver",
                  "value": "<string>",
                  "description": "Filter by receiver name."
                }
              ],
              "variable": [
                {
                  "description": "Alertmanager server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Alertmanager server port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
